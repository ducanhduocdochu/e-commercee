                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Order"
                ],
                "summary": "Hủy đơn hàng",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID của đơn hàng",
                        "name": "order_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Đơn hàng đã bị hủy",
