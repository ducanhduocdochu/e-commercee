    "definitions": {
        "dto.CreateOrderRequest": {
            "description": "Dữ liệu cần thiết để tạo đơn hàng",
            "type": "object",
            "required": [
                "items",
                "order_value"
            ],
            "properties": {
                "discount_id": {
                    "description": "✅ Nếu có thì phải là UUID",
                    "type": "string"
                },
                "discount_value": {
                    "description": "✅ Không được âm",
                    "type": "number",
                    "minimum": 0
                },
                "items": {
                    "description": "✅ Phải có ít nhất một sản phẩm",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.OrderItemRequest"
                    }
                },
                "order_value": {
                    "description": "✅ Không được âm",
                    "type": "number",
                    "minimum": 0
                }
            }
        },
        "dto.OrderItemRequest": {
            "description": "Dữ liệu cần thiết để tạo đơn hàng đại diện cho một mục trong đơn hàng",
            "type": "object",
            "required": [
                "price",
                "product_id",
                "quantity"
            ],
            "properties": {
                "price": {
                    "description": "✅ Giá sản phẩm không được âm",
                    "type": "number",
                    "minimum": 0
                },
                "product_id": {
                    "description": "✅ Phải có product_id hợp lệ (UUID)",
                    "type": "string"
                },
                "quantity": {
                    "description": "✅ Số lượng tối thiểu là 1",
                    "type": "integer",
                    "minimum": 1
                }
            }
        },
        "utils.ApiResponse": {
            "description": "ApiResponse giúp tạo response chuẩn",
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer"
                },
                "message": {
                    "type": "string"
                },
                "result": {}
            }
        }
    }
