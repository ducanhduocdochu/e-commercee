# ==============================
# IGNORE COMPILED JAVA FILES
# ==============================
*.class
*.jar
*.war

# ==============================
# IGNORE BUILD DIRECTORIES
# ==============================
**/target/
**/build/

# Ignore dependency directories
**/.mvn/
**/.gradle/
**/.idea/
**/.vscode/

# Ignore logs
**/logs/
**/*.log
**/nohup.out

# ==============================
# IGNORE OS-SPECIFIC FILES
# ==============================
.DS_Store
Thumbs.db

# ==============================
# IGNORE TEST REPORTS
# ==============================
**/test-output/
**/surefire-reports/
**/jacoco/

# ==============================
# IGNORE FRONTEND FILES (IF EXISTS)
# ==============================
**/node_modules/
**/dist/

# ==============================
# IGNORE CONFIGURATION FILES
# ==============================

# Ignore global environment & configuration files
**/.env
**/.env.local
**/.env.*.local

# Ignore Spring Boot configuration files in all services
identity/src/main/resources/application.yml
identity/src/main/resources/application.yaml
identity/src/main/resources/application.properties
identity/src/main/resources/application-*.yml
identity/src/main/resources/application-*.yaml
identity/src/main/resources/application-*.properties

product/src/main/resources/application.yml
product/src/main/resources/application.yaml
product/src/main/resources/application.properties
product/src/main/resources/application-*.yml
product/src/main/resources/application-*.yaml
product/src/main/resources/application-*.properties

api-gateway/src/main/resources/application.yml
api-gateway/src/main/resources/application.yaml
api-gateway/src/main/resources/application.properties
api-gateway/src/main/resources/application-*.yml
api-gateway/src/main/resources/application-*.yaml
api-gateway/src/main/resources/application-*.properties

# ==============================
# IGNORE SERVICE-SPECIFIC FILES
# ==============================

## Identity service
identity/.env
identity/secrets/

## Product service
product/.env
product/secrets/

## API Gateway service
api-gateway/.env
api-gateway/secrets/

# ==============================
# IGNORE DOCKER & CONTAINER FILES
# ==============================

# Ignore Docker build cache (if using Docker)
**/docker-compose.override.yml
**/.dockerignore
**/docker/data/
**/docker/logs/

# Ignore Kubernetes config files (if using K8s)
**/k8s/
**/kubernetes/

# ==============================
# IGNORE CONFIGURATION FILES FOR NESTJS
# ==============================

# Ignore Spring Boot configuration files for discount service
discount/src/main/resources/application.yml
discount/src/main/resources/application.yaml
discount/src/main/resources/application.properties
discount/src/main/resources/application-*.yml
discount/src/main/resources/application-*.yaml
discount/src/main/resources/application-*.properties

# ==============================
# IGNORE SERVICE-SPECIFIC FILES
# ==============================

## Discount service
discount/.env
discount/secrets/

# ==============================
# IGNORE FRONTEND FILES (IF EXISTS)
# ==============================
**/discount/node_modules/
**/discount/dist/

# ==============================
# IGNORE DOCKER & CONTAINER FILES
# ==============================

# Ignore Docker build cache for discount service
discount/docker-compose.override.yml
discount/.dockerignore
discount/docker/data/
discount/docker/logs/

# ==============================
# IGNORE OTHER FILES FOR DISCOUNT SERVICE
# ==============================

# Ignore any other files related to the discount service
**/discount/*.log
**/discount/test-output/

# ==============================
# IGNORE CONFIGURATION FILES FOR SCHEDULED DISCOUNT SERVICE
# ==============================

# Ignore NestJS configuration files
scheduled-discount/src/main/resources/application.yml
scheduled-discount/src/main/resources/application.yaml
scheduled-discount/src/main/resources/application.properties
scheduled-discount/src/main/resources/application-*.yml
scheduled-discount/src/main/resources/application-*.yaml
scheduled-discount/src/main/resources/application-*.properties

# ==============================
# IGNORE SERVICE-SPECIFIC FILES
# ==============================

## Scheduled Discount service
scheduled-discount/.env
scheduled-discount/secrets/

# ==============================
# IGNORE FRONTEND FILES (IF EXISTS)
# ==============================

**/scheduled-discount/node_modules/
**/scheduled-discount/dist/

# ==============================
# IGNORE BUILD & TEST FILES
# ==============================

**/scheduled-discount/logs/
**/scheduled-discount/test-output/
**/scheduled-discount/coverage/
**/scheduled-discount/*.log
**/scheduled-discount/surefire-reports/
**/scheduled-discount/jacoco/

# ==============================
# IGNORE DOCKER & CONTAINER FILES
# ==============================

scheduled-discount/docker-compose.override.yml
scheduled-discount/.dockerignore
scheduled-discount/docker/data/
scheduled-discount/docker/logs/

# ==============================
# IGNORE OTHER FILES FOR SCHEDULED DISCOUNT SERVICE
# ==============================

# Ignore all temporary or generated files in the service
**/scheduled-discount/tmp/
**/scheduled-discount/.cache/
**/scheduled-discount/.DS_Store
**/scheduled-discount/Thumbs.db

